digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.75", splines=true];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.10,0.08", color="#475569", fillcolor="#f8fafc"];
  edge [fontname="Helvetica", fontsize=9, color="#334155", arrowsize=0.7];
  P [label="Parent: ADAR1 blockade will sensitize tumors to
PD-1 therapy by allowing endogenous
double-stranded RNA to activate antiviral
sensing and tumor inflammation.", fillcolor="#e0f2fe", color="#0284c7", penwidth=1.4];
  N1 [label="viral_sensing_module
One mechanism by which ADAR1 blockade
sensitizes tumors to PD-1 therapy is
activation of endogenous dsRNA-triggered
antiviral sensing in tumor cells.", fillcolor="#ecfdf5"];
  N2 [label="dsrna_accumulation
ADAR1 blockade increases the abundance of
endogenous immunostimulatory double-stranded
RNA in tumor cells.", fillcolor="#f8fafc"];
  N3 [label="antiviral_sensing_activation
Accumulated endogenous double-stranded RNA
activates antiviral sensing in tumor cells.", fillcolor="#f8fafc"];
  N4 [label="tumor_inflammation_induction
Activation of antiviral sensing in tumor
cells induces a tumor inflammatory program.", fillcolor="#f8fafc"];
  N5 [label="cd8_recruitment
A tumor inflammatory program increases CD8
T-cell recruitment into the tumor
microenvironment.", fillcolor="#f8fafc"];
  N6 [label="pd1_response_potentiation
Increased intratumoral CD8 T-cell
infiltration potentiates tumor response to
PD-1 therapy.", fillcolor="#f8fafc"];
  N7 [label="root_therapy_endpoint
ADAR1 blockade sensitizes tumors to PD-1
therapy.", fillcolor="#f8fafc"];
  N1 -> P [label="ALL_OF
sufficient_module", color="#334155", penwidth=1.1];
  N2 -> N1 [label="ALL_OF
required_step", color="#334155", penwidth=1.1];
  N3 -> N1 [label="ALL_OF
required_step", color="#334155", penwidth=1.1];
  N4 -> N1 [label="ALL_OF
required_step", color="#334155", penwidth=1.1];
  N5 -> N1 [label="ALL_OF
required_step", color="#334155", penwidth=1.1];
  N6 -> N1 [label="ALL_OF
required_step", color="#334155", penwidth=1.1];
  N7 -> P [label="ALL_OF
ordinary_child", color="#334155", penwidth=1.1];
  N2 -> N3 [label="enables", style=dashed, color="#2563eb", fontcolor="#2563eb", constraint=false];
  N3 -> N4 [label="candidate_mechanism_link", style=dashed, color="#2563eb", fontcolor="#2563eb", constraint=false];
  N4 -> N5 [label="candidate_mechanism_link", style=dashed, color="#2563eb", fontcolor="#2563eb", constraint=false];
  N5 -> N6 [label="candidate_mechanism_link", style=dashed, color="#2563eb", fontcolor="#2563eb", constraint=false];
  N1 -> N7 [label="refines", style=dashed, color="#2563eb", fontcolor="#2563eb", constraint=false];
  N1 -> N2 [label="candidate_mechanism_link", style=dashed, color="#2563eb", fontcolor="#2563eb", constraint=false];
